{
  "version": 2,
  "builds": [
    {
      "src": "src/vercel.ts",
      "use": "@vercel/node"
    }
  ],
  "crons": [
    {
      "path": "/cron/process-alerts",
      "schedule": "0 15 * * *"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/vercel.ts",
      "headers": {
        "Access-Control-Allow-Origin": "https://tybacha.vercel.app",
        "Access-Control-Allow-Credentials": "true",
        "Access-Control-Allow-Methods": "GET,POST,PUT,PATCH,DELETE,OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization"
      }
    }
  ]
}
